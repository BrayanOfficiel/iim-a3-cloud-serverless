{
  "name": "launchpad-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "lint": "bunx biome check src/",
    "build": "bun build src/lambda.ts --outdir dist --target node",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.0",
    "jose": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.30.0",
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.7.0",
    "@types/bun": "latest"
  }
}
